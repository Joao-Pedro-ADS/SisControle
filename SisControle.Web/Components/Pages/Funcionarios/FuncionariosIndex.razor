@page "/funcionarios"
@rendermode InteractiveServer
@inject FuncionarioService FuncionarioSvc
@inject FilialService FilialSvc

<PageTitle>Funcionários — SisControle</PageTitle>

<SectionContent SectionName="page-title">Funcionários</SectionContent>

@if (mensagem != null)
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<div class="sc-table-card">

    <!-- Toolbar -->
    <div class="sc-toolbar">
        <span class="sc-count">@FuncionariosFiltrados.Count() funcionários</span>
        <div class="d-flex gap-2 align-items-center">
            <div class="sc-search-wrap">
                <input type="text" placeholder="Buscar..." @bind="busca" @bind:event="oninput" />
            </div>
            <button class="btn btn-primary btn-sm" @onclick="() => AbrirModal(null)">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Novo Funcionário
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:2.5rem">#</th>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Cargo</th>
                    <th>Filial</th>
                    <th>Admissão</th>
                    <th>Status</th>
                    <th class="text-center" style="width:5rem">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!FuncionariosFiltrados.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color:#aaaaaa;font-size:0.8rem">
                            Nenhum funcionário encontrado
                        </td>
                    </tr>
                }
                @{ int i = 0; }
                @foreach (var f in FuncionariosFiltrados)
                {
                    i++;
                    <tr>
                        <td class="text-end" style="color:#aaaaaa;font-size:0.7rem">@i</td>
                        <td style="font-weight:500">@f.Nome</td>
                        <td style="font-family:monospace;font-size:0.7rem;color:#6e6e73">@f.Cpf</td>
                        <td style="color:#6e6e73">@(f.Cargo ?? "—")</td>
                        <td style="color:#6e6e73">@f.Filial?.Nome</td>
                        <td style="color:#6e6e73;font-size:0.7rem">@f.DataAdmissao.ToString("dd/MM/yyyy")</td>
                        <td>
                            @{
                                var (bg, fg) = f.Status switch
                                {
                                    StatusFuncionario.Ativo    => ("#e8f5e9", "#2e7d32"),
                                    StatusFuncionario.Inativo  => ("#f5f5f7", "#6e6e73"),
                                    StatusFuncionario.Afastado => ("#fff8e1", "#e65100"),
                                    _                          => ("#f5f5f7", "#6e6e73")
                                };
                            }
                            <span class="badge" style="background:@bg;color:@fg">@f.Status</span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <button class="sc-btn-icon edit" title="Editar" @onclick="() => AbrirModal(f)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                                <button class="sc-btn-icon delete" title="Excluir" @onclick="() => ExcluirAsync(f.Id)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="sc-table-foot">
        @FuncionariosFiltrados.Count() de @funcionarios.Count funcionários
    </div>
</div>

@if (modalAberto)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.35)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modelo.Id == 0 ? "Novo Funcionário" : "Editar Funcionário")</h5>
                    <button class="sc-btn-close" @onclick="() => modalAberto = false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nome *</label>
                        <input class="form-control" @bind="modelo.Nome" placeholder="Nome completo" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">CPF *</label>
                            <input class="form-control" @bind="modelo.Cpf" placeholder="000.000.000-00" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Cargo</label>
                            <input class="form-control" @bind="modelo.Cargo" placeholder="Ex: Gerente" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Filial *</label>
                            <select class="form-select" @bind="modelo.FilialId">
                                <option value="0">Selecione...</option>
                                @foreach (var f in filiais)
                                {
                                    <option value="@f.Id">@f.Nome</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Telefone</label>
                            <input class="form-control" @bind="modelo.Telefone" placeholder="Ex: (11) 99000-0000" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" @bind="modelo.Email" placeholder="Ex: nome@email.com" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">Status</label>
                            <select class="form-select" @bind="modelo.Status">
                                @foreach (var s in Enum.GetValues<StatusFuncionario>())
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Data Admissão</label>
                            <input type="date" class="form-control" @bind="modelo.DataAdmissao" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => modalAberto = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarAsync">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Funcionario> funcionarios = new();
    private List<Filial> filiais = new();
    private Funcionario modelo = new();
    private bool modalAberto = false;
    private string? mensagem;
    private bool erro = false;
    private string busca = "";

    private IEnumerable<Funcionario> FuncionariosFiltrados =>
        string.IsNullOrEmpty(busca) ? funcionarios :
        funcionarios.Where(f =>
            f.Nome.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            f.Cpf.Contains(busca) ||
            (f.Cargo ?? "").Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            (f.Filial?.Nome ?? "").Contains(busca, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        funcionarios = (await FuncionarioSvc.ListarAsync()).ToList();
        filiais      = (await FilialSvc.ListarAsync()).ToList();
    }

    private void AbrirModal(Funcionario? f)
    {
        modelo = f == null ? new Funcionario { DataAdmissao = DateTime.Today } : new Funcionario
        {
            Id = f.Id, Nome = f.Nome, Cpf = f.Cpf, Cargo = f.Cargo,
            FilialId = f.FilialId, Telefone = f.Telefone, Email = f.Email,
            Status = f.Status, DataAdmissao = f.DataAdmissao
        };
        modalAberto = true;
    }

    private async Task SalvarAsync()
    {
        try
        {
            if (modelo.Id == 0) await FuncionarioSvc.CadastrarAsync(modelo);
            else await FuncionarioSvc.AtualizarAsync(modelo);
            funcionarios = (await FuncionarioSvc.ListarAsync()).ToList();
            modalAberto = false;
            mensagem = "Funcionário salvo!";
            erro = false;
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }

    private async Task ExcluirAsync(int id)
    {
        try
        {
            await FuncionarioSvc.ExcluirAsync(id);
            funcionarios = (await FuncionarioSvc.ListarAsync()).ToList();
            mensagem = "Funcionário removido.";
            erro = false;
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }
}
