@page "/fornecedores"
@rendermode InteractiveServer
@inject FornecedorService FornecedorSvc

<PageTitle>Fornecedores — SisControle</PageTitle>

<SectionContent SectionName="page-title">Fornecedores</SectionContent>

@if (mensagem != null)
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<div class="sc-table-card">

    <!-- Toolbar -->
    <div class="sc-toolbar">
        <span class="sc-count">@FornecedoresFiltrados.Count() fornecedores</span>
        <div class="d-flex gap-2 align-items-center">
            <div class="sc-search-wrap">
                <input type="text" placeholder="Buscar..." @bind="busca" @bind:event="oninput" />
            </div>
            <button class="btn btn-primary btn-sm" @onclick="() => AbrirModal(null)">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Novo Fornecedor
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:2.5rem">#</th>
                    <th>Nome</th>
                    <th>CNPJ</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th class="text-center" style="width:5rem">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!FornecedoresFiltrados.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:#aaaaaa;font-size:0.8rem">
                            Nenhum fornecedor encontrado
                        </td>
                    </tr>
                }
                @{ int i = 0; }
                @foreach (var f in FornecedoresFiltrados)
                {
                    i++;
                    <tr>
                        <td class="text-end" style="color:#aaaaaa;font-size:0.7rem">@i</td>
                        <td style="font-weight:500">@f.Nome</td>
                        <td style="font-family:monospace;font-size:0.7rem;color:#6e6e73">@f.Cnpj</td>
                        <td style="color:#6e6e73">@(f.Telefone ?? "—")</td>
                        <td style="color:#6e6e73">
                            @if (!string.IsNullOrEmpty(f.Email))
                            {
                                <a href="mailto:@f.Email" style="color:inherit">@f.Email</a>
                            }
                            else
                            {
                                <span style="color:#c7c7cc">—</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <button class="sc-btn-icon edit" title="Editar" @onclick="() => AbrirModal(f)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                                <button class="sc-btn-icon delete" title="Excluir" @onclick="() => ExcluirAsync(f.Id)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="sc-table-foot">
        @FornecedoresFiltrados.Count() de @fornecedores.Count fornecedores
    </div>
</div>

@if (modalAberto)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.35)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modelo.Id == 0 ? "Novo Fornecedor" : "Editar Fornecedor")</h5>
                    <button class="sc-btn-close" @onclick="() => modalAberto = false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nome *</label>
                        <input class="form-control" @bind="modelo.Nome" placeholder="Ex: Distribuidora Sul" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">CNPJ *</label>
                            <input class="form-control" @bind="modelo.Cnpj" placeholder="00.000.000/0001-00" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Telefone</label>
                            <input class="form-control" @bind="modelo.Telefone" placeholder="Ex: (11) 3000-1000" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" @bind="modelo.Email" placeholder="Ex: contato@empresa.com.br" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Endereço</label>
                        <input class="form-control" @bind="modelo.Endereco" placeholder="Ex: Av. Paulista, 1000" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => modalAberto = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarAsync">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Fornecedor> fornecedores = new();
    private Fornecedor modelo = new();
    private bool modalAberto = false;
    private string? mensagem;
    private bool erro = false;
    private string busca = "";

    private IEnumerable<Fornecedor> FornecedoresFiltrados =>
        string.IsNullOrEmpty(busca) ? fornecedores :
        fornecedores.Where(f =>
            f.Nome.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            f.Cnpj.Contains(busca) ||
            (f.Email ?? "").Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            (f.Telefone ?? "").Contains(busca));

    protected override async Task OnInitializedAsync()
        => fornecedores = (await FornecedorSvc.ListarAsync()).ToList();

    private void AbrirModal(Fornecedor? f)
    {
        modelo = f == null ? new Fornecedor() : new Fornecedor
        {
            Id = f.Id, Nome = f.Nome, Cnpj = f.Cnpj,
            Telefone = f.Telefone, Email = f.Email, Endereco = f.Endereco
        };
        modalAberto = true;
    }

    private async Task SalvarAsync()
    {
        try
        {
            if (modelo.Id == 0) await FornecedorSvc.CadastrarAsync(modelo);
            else await FornecedorSvc.AtualizarAsync(modelo);
            fornecedores = (await FornecedorSvc.ListarAsync()).ToList();
            modalAberto = false;
            mensagem = "Fornecedor salvo!";
            erro = false;
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }

    private async Task ExcluirAsync(int id)
    {
        try
        {
            await FornecedorSvc.ExcluirAsync(id);
            fornecedores = (await FornecedorSvc.ListarAsync()).ToList();
            mensagem = "Fornecedor removido.";
            erro = false;
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }
}
