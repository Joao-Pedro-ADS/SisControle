@page "/produtos"
@rendermode InteractiveServer
@inject ProdutoService ProdutoSvc
@inject CategoriaService CategoriaSvc

<PageTitle>Produtos — SisControle</PageTitle>

<SectionContent SectionName="page-title">Produtos</SectionContent>

@if (mensagem != null)
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<div class="sc-table-card">

    <!-- Toolbar -->
    <div class="sc-toolbar">
        <span class="sc-count">@ProdutosFiltrados.Count() produtos</span>
        <div class="d-flex gap-2 align-items-center">
            <div class="sc-search-wrap">
                <input type="text" placeholder="Buscar por nome..." @bind="filtro" @bind:event="oninput" />
            </div>
            <button class="btn btn-primary btn-sm" @onclick="() => AbrirModal(null)">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Novo Produto
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:2.5rem">#</th>
                    <th>Nome</th>
                    <th>Cód. Barras</th>
                    <th>Categoria</th>
                    <th class="text-end">Preço Custo</th>
                    <th class="text-end">Preço Venda</th>
                    <th class="text-end">Est. Mín.</th>
                    <th class="text-center" style="width:5rem">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!ProdutosFiltrados.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color:#aaaaaa;font-size:0.8rem">
                            Nenhum produto encontrado
                        </td>
                    </tr>
                }
                @{ int i = 0; }
                @foreach (var p in ProdutosFiltrados)
                {
                    i++;
                    <tr>
                        <td class="text-end" style="color:#aaaaaa;font-size:0.7rem">@i</td>
                        <td style="font-weight:500">@p.Nome</td>
                        <td style="font-family:monospace;font-size:0.7rem;color:#6e6e73">
                            @(string.IsNullOrEmpty(p.CodigoBarras) ? "—" : p.CodigoBarras)
                        </td>
                        <td>
                            @if (p.Categoria != null)
                            {
                                <span class="badge bg-primary">@p.Categoria.Nome</span>
                            }
                        </td>
                        <td class="text-end" style="color:#6e6e73;font-variant-numeric:tabular-nums">
                            @p.PrecoCusto.ToString("C")
                        </td>
                        <td class="text-end" style="font-weight:500;font-variant-numeric:tabular-nums">
                            @p.PrecoVenda.ToString("C")
                        </td>
                        <td class="text-end" style="color:#6e6e73">@p.EstoqueMinimo</td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <button class="sc-btn-icon edit" title="Editar" @onclick="() => AbrirModal(p)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                                <button class="sc-btn-icon delete" title="Excluir" @onclick="() => ExcluirAsync(p.Id)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="sc-table-foot">
        @ProdutosFiltrados.Count() de @produtos.Count produtos
    </div>
</div>

@if (modalAberto)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.35)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modelo.Id == 0 ? "Novo Produto" : "Editar Produto")</h5>
                    <button class="sc-btn-close" @onclick="() => modalAberto = false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nome *</label>
                        <input class="form-control" @bind="modelo.Nome" placeholder="Ex: Monitor UltraWide 34&quot;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Código de Barras</label>
                        <input class="form-control" @bind="modelo.CodigoBarras" placeholder="EAN-13 ou outro" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Categoria *</label>
                        <select class="form-select" @bind="modelo.CategoriaId">
                            <option value="0">Selecione...</option>
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Id">@c.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Preço Custo *</label>
                            <input type="number" step="0.01" class="form-control" @bind="modelo.PrecoCusto" placeholder="0,00" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Preço Venda *</label>
                            <input type="number" step="0.01" class="form-control" @bind="modelo.PrecoVenda" placeholder="0,00" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Estoque Mínimo</label>
                        <input type="number" class="form-control" @bind="modelo.EstoqueMinimo" placeholder="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => modalAberto = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarAsync">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Produto> produtos = new();
    private List<Categoria> categorias = new();
    private Produto modelo = new();
    private bool modalAberto = false;
    private string? mensagem;
    private bool erro = false;
    private string filtro = string.Empty;

    private IEnumerable<Produto> ProdutosFiltrados =>
        string.IsNullOrWhiteSpace(filtro)
            ? produtos
            : produtos.Where(p => p.Nome.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        produtos   = (await ProdutoSvc.ListarAsync()).ToList();
        categorias = (await CategoriaSvc.ListarAsync()).ToList();
    }

    private void AbrirModal(Produto? p)
    {
        modelo = p == null ? new Produto() : new Produto
        {
            Id = p.Id, Nome = p.Nome, CodigoBarras = p.CodigoBarras,
            CategoriaId = p.CategoriaId, PrecoCusto = p.PrecoCusto,
            PrecoVenda = p.PrecoVenda, EstoqueMinimo = p.EstoqueMinimo
        };
        modalAberto = true;
    }

    private async Task SalvarAsync()
    {
        try
        {
            if (modelo.Id == 0) await ProdutoSvc.CadastrarAsync(modelo);
            else await ProdutoSvc.AtualizarAsync(modelo);
            produtos = (await ProdutoSvc.ListarAsync()).ToList();
            modalAberto = false;
            mensagem = "Produto salvo com sucesso!";
            erro = false;
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }

    private async Task ExcluirAsync(int id)
    {
        try
        {
            await ProdutoSvc.ExcluirAsync(id);
            produtos = (await ProdutoSvc.ListarAsync()).ToList();
            mensagem = "Produto removido.";
            erro = false;
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }
}
