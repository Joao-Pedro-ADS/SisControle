@page "/categorias"
@rendermode InteractiveServer
@inject CategoriaService CategoriaSvc

<PageTitle>Categorias — SisControle</PageTitle>

<SectionContent SectionName="page-title">Categorias de Produto</SectionContent>

@if (mensagem != null)
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<div class="sc-table-card">

    <!-- Toolbar -->
    <div class="sc-toolbar">
        <span class="sc-count">@CategoriasFiltradas.Count() categorias</span>
        <div class="d-flex gap-2 align-items-center">
            <div class="sc-search-wrap">
                <input type="text" placeholder="Buscar..." @bind="busca" @bind:event="oninput" />
            </div>
            <button class="btn btn-primary btn-sm" @onclick="() => AbrirModal(null)">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nova Categoria
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:2.5rem">#</th>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th class="text-center" style="width:5rem">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!CategoriasFiltradas.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5" style="color:#aaaaaa;font-size:0.8rem">
                            Nenhuma categoria encontrada
                        </td>
                    </tr>
                }
                @{ int i = 0; }
                @foreach (var c in CategoriasFiltradas)
                {
                    i++;
                    <tr>
                        <td class="text-end" style="color:#aaaaaa;font-size:0.7rem">@i</td>
                        <td style="font-weight:500">@c.Nome</td>
                        <td style="color:#6e6e73">@(c.Descricao ?? "—")</td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <button class="sc-btn-icon edit" title="Editar" @onclick="() => AbrirModal(c)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                                <button class="sc-btn-icon delete" title="Excluir" @onclick="() => ExcluirAsync(c.Id)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="sc-table-foot">
        @CategoriasFiltradas.Count() de @categorias.Count categorias
    </div>
</div>

@if (modalAberto)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.35)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modelo.Id == 0 ? "Nova Categoria" : "Editar Categoria")</h5>
                    <button class="sc-btn-close" @onclick="() => modalAberto = false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nome *</label>
                        <input class="form-control" @bind="modelo.Nome" placeholder="Ex: Eletrônicos" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Descrição</label>
                        <textarea class="form-control" @bind="modelo.Descricao" rows="2" placeholder="Descrição opcional"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => modalAberto = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarAsync">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Categoria> categorias = new();
    private Categoria modelo = new();
    private bool modalAberto = false;
    private string? mensagem;
    private bool erro = false;
    private string busca = "";

    private IEnumerable<Categoria> CategoriasFiltradas =>
        string.IsNullOrEmpty(busca) ? categorias :
        categorias.Where(c => c.Nome.Contains(busca, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
        => categorias = (await CategoriaSvc.ListarAsync()).ToList();

    private void AbrirModal(Categoria? c)
    {
        modelo = c == null ? new Categoria() : new Categoria { Id = c.Id, Nome = c.Nome, Descricao = c.Descricao };
        modalAberto = true;
    }

    private async Task SalvarAsync()
    {
        try
        {
            if (modelo.Id == 0) await CategoriaSvc.CadastrarAsync(modelo);
            else await CategoriaSvc.AtualizarAsync(modelo);
            categorias = (await CategoriaSvc.ListarAsync()).ToList();
            modalAberto = false;
            mensagem = "Categoria salva!";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }

    private async Task ExcluirAsync(int id)
    {
        try
        {
            await CategoriaSvc.ExcluirAsync(id);
            categorias = (await CategoriaSvc.ListarAsync()).ToList();
            mensagem = "Categoria removida.";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }
}
