@page "/clientes"
@rendermode InteractiveServer
@inject ClienteService ClienteSvc

<PageTitle>Clientes — SisControle</PageTitle>

<SectionContent SectionName="page-title">Clientes</SectionContent>

@if (mensagem != null)
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<div class="sc-table-card">

    <!-- Toolbar -->
    <div class="sc-toolbar">
        <span class="sc-count">@ClientesFiltrados.Count() clientes</span>
        <div class="d-flex gap-2 align-items-center">
            <div class="sc-search-wrap">
                <input type="text" placeholder="Buscar..." @bind="filtro" @bind:event="oninput" />
            </div>
            <button class="btn btn-primary btn-sm" @onclick="() => AbrirModal(null)">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Novo Cliente
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:2.5rem">#</th>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th class="text-center" style="width:5rem">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!ClientesFiltrados.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:#aaaaaa;font-size:0.8rem">
                            Nenhum cliente encontrado
                        </td>
                    </tr>
                }
                @{ int i = 0; }
                @foreach (var c in ClientesFiltrados)
                {
                    i++;
                    <tr>
                        <td class="text-end" style="color:#aaaaaa;font-size:0.7rem">@i</td>
                        <td style="font-weight:500">@c.Nome</td>
                        <td style="font-family:monospace;font-size:0.7rem;color:#6e6e73">@(c.Cpf ?? "—")</td>
                        <td style="color:#6e6e73">@(c.Telefone ?? "—")</td>
                        <td style="color:#6e6e73">@(c.Email ?? "—")</td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <button class="sc-btn-icon edit" title="Editar" @onclick="() => AbrirModal(c)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                                <button class="sc-btn-icon delete" title="Excluir" @onclick="() => ExcluirAsync(c.Id)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="sc-table-foot">
        @ClientesFiltrados.Count() de @clientes.Count clientes
    </div>
</div>

@if (modalAberto)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.35)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modelo.Id == 0 ? "Novo Cliente" : "Editar Cliente")</h5>
                    <button class="sc-btn-close" @onclick="() => modalAberto = false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nome *</label>
                        <input class="form-control" @bind="modelo.Nome" placeholder="Nome completo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">CPF</label>
                        <input class="form-control" @bind="modelo.Cpf" placeholder="000.000.000-00" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Telefone</label>
                        <input class="form-control" @bind="modelo.Telefone" placeholder="Ex: (11) 99000-0000" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" @bind="modelo.Email" placeholder="Ex: nome@email.com" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => modalAberto = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarAsync">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Cliente> clientes = new();
    private Cliente modelo = new();
    private bool modalAberto = false;
    private string? mensagem;
    private bool erro = false;
    private string filtro = string.Empty;

    private IEnumerable<Cliente> ClientesFiltrados =>
        string.IsNullOrWhiteSpace(filtro)
            ? clientes
            : clientes.Where(c => c.Nome.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
        => clientes = (await ClienteSvc.ListarAsync()).ToList();

    private void AbrirModal(Cliente? c)
    {
        modelo = c == null ? new Cliente() : new Cliente
        {
            Id = c.Id, Nome = c.Nome, Cpf = c.Cpf, Telefone = c.Telefone, Email = c.Email
        };
        modalAberto = true;
    }

    private async Task SalvarAsync()
    {
        try
        {
            if (modelo.Id == 0) await ClienteSvc.CadastrarAsync(modelo);
            else await ClienteSvc.AtualizarAsync(modelo);
            clientes = (await ClienteSvc.ListarAsync()).ToList();
            modalAberto = false;
            mensagem = "Cliente salvo!";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }

    private async Task ExcluirAsync(int id)
    {
        try
        {
            await ClienteSvc.ExcluirAsync(id);
            clientes = (await ClienteSvc.ListarAsync()).ToList();
            mensagem = "Cliente removido.";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }
}
