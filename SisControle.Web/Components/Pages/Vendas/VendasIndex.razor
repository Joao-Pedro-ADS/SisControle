@page "/vendas"
@rendermode InteractiveServer
@inject VendaService VendaSvc
@inject FilialService FilialSvc

<PageTitle>Vendas — SisControle</PageTitle>

<SectionContent SectionName="page-title">Vendas</SectionContent>

@if (mensagem != null)
{
    <div class="alert alert-info alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<!-- Filters -->
<div class="sc-table-card mb-3 p-3" style="border-radius:0.75rem">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Filial</label>
            <select class="form-select" @bind="filialId">
                <option value="0">Todas</option>
                @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">De</label>
            <input type="date" class="form-control" @bind="inicio" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Até</label>
            <input type="date" class="form-control" @bind="fim" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100" @onclick="CarregarAsync">Filtrar</button>
        </div>
    </div>
</div>

<!-- Summary -->
@if (vendas.Any())
{
    <div class="mb-3 d-flex align-items-center gap-2">
        <span style="font-size:0.75rem;color:#aaaaaa">Total faturado no período:</span>
        <span style="font-size:1.1rem;font-weight:600;color:#2e7d32">@vendas.Sum(v => v.ValorTotal).ToString("C")</span>
    </div>
}

<div class="sc-table-card">
    <div class="sc-toolbar">
        <span class="sc-count">@vendas.Count vendas</span>
        <a href="/vendas/nova" class="btn btn-primary btn-sm">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nova Venda
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:2.5rem">#</th>
                    <th>Data/Hora</th>
                    <th>Filial</th>
                    <th>Cliente</th>
                    <th class="text-end">Itens</th>
                    <th class="text-end">Total</th>
                    <th>Pagamento</th>
                </tr>
            </thead>
            <tbody>
                @if (!vendas.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5" style="color:#aaaaaa;font-size:0.8rem">
                            Nenhuma venda encontrada no período
                        </td>
                    </tr>
                }
                @{ int i = 0; }
                @foreach (var v in vendas)
                {
                    i++;
                    <tr>
                        <td class="text-end" style="color:#aaaaaa;font-size:0.7rem">@i</td>
                        <td style="font-size:0.72rem;color:#6e6e73">@v.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="color:#6e6e73">@v.Filial?.Nome</td>
                        <td style="color:#6e6e73">@(v.Cliente?.Nome ?? "Consumidor final")</td>
                        <td class="text-end" style="color:#6e6e73">@v.Itens.Count</td>
                        <td class="text-end fw-bold text-success" style="font-variant-numeric:tabular-nums">@v.ValorTotal.ToString("C")</td>
                        <td><span class="badge bg-secondary">@v.FormaPagamento</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="sc-table-foot">@vendas.Count vendas</div>
</div>

@code {
    private List<Venda> vendas = new();
    private List<Filial> filiais = new();
    private int filialId = 0;
    private DateTime inicio = DateTime.Today.AddDays(-7);
    private DateTime fim = DateTime.Today;
    private string? mensagem;

    protected override async Task OnInitializedAsync()
    {
        filiais = (await FilialSvc.ListarAsync()).ToList();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        if (filialId == 0)
            vendas = (await VendaSvc.ListarPorPeriodoAsync(inicio, fim.AddDays(1))).ToList();
        else
            vendas = (await VendaSvc.ListarPorFilialEPeriodoAsync(filialId, inicio, fim.AddDays(1))).ToList();
    }
}
