@page "/vendas"
@rendermode InteractiveServer
@inject VendaService VendaSvc
@inject FilialService FilialSvc

<PageTitle>Vendas — SisControle</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Vendas</h2>
        <a href="/vendas/nova" class="btn btn-primary">+ Nova Venda</a>
    </div>

    @if (mensagem != null)
    {
        <div class="alert alert-info alert-dismissible">
            @mensagem
            <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label">Filial</label>
            <select class="form-select" @bind="filialId">
                <option value="0">Todas</option>
                @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">De</label>
            <input type="date" class="form-control" @bind="inicio" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Até</label>
            <input type="date" class="form-control" @bind="fim" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100" @onclick="CarregarAsync">Filtrar</button>
        </div>
    </div>

    <div class="mb-2">
        <strong>Total faturado no período: </strong>
        <span class="text-success fw-bold fs-5">@vendas.Sum(v => v.ValorTotal).ToString("C")</span>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th><th>Data/Hora</th><th>Filial</th><th>Cliente</th>
                    <th>Itens</th><th>Total</th><th>Pagamento</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in vendas)
                {
                    <tr>
                        <td>@v.Id</td>
                        <td>@v.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@v.Filial?.Nome</td>
                        <td>@(v.Cliente?.Nome ?? "Consumidor final")</td>
                        <td>@v.Itens.Count</td>
                        <td class="fw-bold text-success">@v.ValorTotal.ToString("C")</td>
                        <td>@v.FormaPagamento</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Venda> vendas = new();
    private List<Filial> filiais = new();
    private int filialId = 0;
    private DateTime inicio = DateTime.Today.AddDays(-7);
    private DateTime fim = DateTime.Today;
    private string? mensagem;

    protected override async Task OnInitializedAsync()
    {
        filiais = (await FilialSvc.ListarAsync()).ToList();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        if (filialId == 0)
            vendas = (await VendaSvc.ListarPorPeriodoAsync(inicio, fim.AddDays(1))).ToList();
        else
            vendas = (await VendaSvc.ListarPorFilialEPeriodoAsync(filialId, inicio, fim.AddDays(1))).ToList();
    }
}
