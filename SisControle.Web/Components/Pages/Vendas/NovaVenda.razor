@page "/vendas/nova"
@rendermode InteractiveServer
@inject VendaService VendaSvc
@inject FilialService FilialSvc
@inject ProdutoService ProdutoSvc
@inject FuncionarioService FuncionarioSvc
@inject ClienteService ClienteSvc
@inject NavigationManager Nav

<PageTitle>Nova Venda — SisControle</PageTitle>

<SectionContent SectionName="page-title">Registrar Venda</SectionContent>

@if (mensagem != null)
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<!-- Sale details -->
<div class="sc-table-card mb-3 p-3" style="border-radius:0.75rem">
    <div style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#aaaaaa;margin-bottom:0.75rem">Dados da Venda</div>
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label">Filial *</label>
            <select class="form-select" @bind="filialId" @bind:after="CarregarFuncionariosAsync">
                <option value="0">Selecione...</option>
                @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Funcionário *</label>
            <select class="form-select" @bind="funcionarioId">
                <option value="0">Selecione...</option>
                @foreach (var f in funcionarios) { <option value="@f.Id">@f.Nome</option> }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Cliente</label>
            <select class="form-select" @bind="clienteId">
                <option value="0">Consumidor final</option>
                @foreach (var c in clientes) { <option value="@c.Id">@c.Nome</option> }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Forma de Pagamento *</label>
            <select class="form-select" @bind="formaPagamento">
                <option value="">Selecione...</option>
                <option value="Dinheiro">Dinheiro</option>
                <option value="Cartão Débito">Cartão Débito</option>
                <option value="Cartão Crédito">Cartão Crédito</option>
                <option value="Pix">Pix</option>
            </select>
        </div>
    </div>
</div>

<!-- Add items -->
<div class="sc-table-card mb-3 p-3" style="border-radius:0.75rem">
    <div style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#aaaaaa;margin-bottom:0.75rem">Adicionar Itens</div>
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Produto *</label>
            <select class="form-select" @bind="addProdutoId">
                <option value="0">Selecione...</option>
                @foreach (var p in produtos) { <option value="@p.Id">@p.Nome (@p.PrecoVenda.ToString("C"))</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Quantidade *</label>
            <input type="number" min="1" class="form-control" @bind="addQuantidade" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100" @onclick="AdicionarItem">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Adicionar
            </button>
        </div>
    </div>
</div>

<!-- Cart -->
@if (itens.Any())
{
    <div class="mb-2">
        <h5>Itens da Venda</h5>
    </div>
    <div class="sc-table-card mb-3">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Produto</th>
                        <th class="text-end">Qtd</th>
                        <th class="text-end">Preço Unit.</th>
                        <th class="text-end">Subtotal</th>
                        <th style="width:2rem"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in itens)
                    {
                        <tr>
                            <td style="font-weight:500">@item.NomeProduto</td>
                            <td class="text-end" style="color:#6e6e73">@item.Quantidade</td>
                            <td class="text-end" style="color:#6e6e73;font-variant-numeric:tabular-nums">@item.PrecoUnitario.ToString("C")</td>
                            <td class="text-end fw-bold" style="font-variant-numeric:tabular-nums">@((item.Quantidade * item.PrecoUnitario).ToString("C"))</td>
                            <td>
                                <button class="sc-btn-icon delete" title="Remover" @onclick="() => itens.Remove(item)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:#fafafa;border-top:1px solid rgba(0,0,0,0.08)">
                        <td colspan="3" class="text-end" style="font-size:0.75rem;color:#6e6e73;font-weight:600">TOTAL:</td>
                        <td class="text-end fw-bold text-success" style="font-size:1.05rem;font-variant-numeric:tabular-nums">
                            @itens.Sum(i => i.Quantidade * i.PrecoUnitario).ToString("C")
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<!-- Actions -->
<div class="d-flex gap-2">
    <button class="btn btn-primary" @onclick="ConfirmarVendaAsync" disabled="@(!itens.Any())">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px"><polyline points="20 6 9 17 4 12"/></svg>
        Confirmar Venda
    </button>
    <a href="/vendas" class="btn btn-secondary">Cancelar</a>
</div>

@code {
    record ItemCarrinho(int ProdutoId, string NomeProduto, int Quantidade, decimal PrecoUnitario);

    private List<Filial> filiais = new();
    private List<Funcionario> funcionarios = new();
    private List<Cliente> clientes = new();
    private List<Produto> produtos = new();
    private List<ItemCarrinho> itens = new();

    private int filialId, funcionarioId, clienteId, addProdutoId;
    private int addQuantidade = 1;
    private string formaPagamento = string.Empty;
    private string? mensagem;
    private bool erro = false;

    protected override async Task OnInitializedAsync()
    {
        filiais = (await FilialSvc.ListarAsync()).ToList();
        clientes = (await ClienteSvc.ListarAsync()).ToList();
        produtos = (await ProdutoSvc.ListarAsync()).ToList();
    }

    private async Task CarregarFuncionariosAsync()
    {
        if (filialId > 0)
            funcionarios = (await FuncionarioSvc.ListarPorFilialAsync(filialId)).ToList();
    }

    private void AdicionarItem()
    {
        if (addProdutoId == 0 || addQuantidade <= 0) return;
        var produto = produtos.FirstOrDefault(p => p.Id == addProdutoId);
        if (produto == null) return;

        var existente = itens.FirstOrDefault(i => i.ProdutoId == addProdutoId);
        if (existente != null) itens.Remove(existente);
        itens.Add(new ItemCarrinho(produto.Id, produto.Nome, addQuantidade, produto.PrecoVenda));
        addProdutoId = 0;
        addQuantidade = 1;
    }

    private async Task ConfirmarVendaAsync()
    {
        try
        {
            if (filialId == 0) throw new InvalidOperationException("Selecione a filial.");
            if (funcionarioId == 0) throw new InvalidOperationException("Selecione o funcionário.");
            if (string.IsNullOrWhiteSpace(formaPagamento)) throw new InvalidOperationException("Selecione a forma de pagamento.");

            var venda = new Venda
            {
                FilialId = filialId,
                FuncionarioId = funcionarioId,
                ClienteId = clienteId == 0 ? null : clienteId,
                FormaPagamento = formaPagamento,
                Itens = itens.Select(i => new ItemVenda
                {
                    ProdutoId = i.ProdutoId,
                    Quantidade = i.Quantidade,
                    PrecoUnitario = i.PrecoUnitario
                }).ToList()
            };

            await VendaSvc.RegistrarVendaAsync(venda);
            Nav.NavigateTo("/vendas");
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }
}
