@page "/relatorios"
@rendermode InteractiveServer
@inject RelatorioService RelatorioSvc
@inject FilialService FilialSvc

<PageTitle>Relatórios — SisControle</PageTitle>

<SectionContent SectionName="page-title">Relatórios Gerenciais</SectionContent>

<!-- Filters -->
<div class="sc-table-card mb-4 p-3" style="border-radius:0.75rem">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">De</label>
            <input type="date" class="form-control" @bind="inicio" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Até</label>
            <input type="date" class="form-control" @bind="fim" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Filial</label>
            <select class="form-select" @bind="filialId">
                <option value="0">Toda a rede</option>
                @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100" @onclick="GerarAsync" disabled="@carregando">
                @if (carregando)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Gerando...</span>
                }
                else
                {
                    <span>Gerar Relatório</span>
                }
            </button>
        </div>
    </div>
</div>

@if (relatorio.Any())
{
    <!-- Summary metric cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="sc-metric-card">
                <div class="sc-metric-icon" style="background:#e8f0fd">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0071e3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div class="sc-metric-label">Faturamento Total</div>
                <div class="sc-metric-value">@relatorio.Sum(r => r.TotalFaturado).ToString("C")</div>
                <div class="sc-metric-sub">@inicio.ToString("dd/MM") a @fim.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sc-metric-card">
                <div class="sc-metric-icon" style="background:#fff0ef">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ff3b30" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                </div>
                <div class="sc-metric-label">Total Despesas</div>
                <div class="sc-metric-value" style="color:#ff3b30">@relatorio.Sum(r => r.TotalDespesas).ToString("C")</div>
                <div class="sc-metric-sub">Período selecionado</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sc-metric-card">
                <div class="sc-metric-icon" style="background:#e8f5e9">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                </div>
                <div class="sc-metric-label">Margem Bruta</div>
                @{ var margem = relatorio.Sum(r => r.MargemBruta); }
                <div class="sc-metric-value" style="color:@(margem >= 0 ? "#2e7d32" : "#ff3b30")">@margem.ToString("C")</div>
                <div class="sc-metric-sub">Receita − Despesas</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sc-metric-card">
                <div class="sc-metric-icon" style="background:#e3f2fd">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0288d1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                </div>
                <div class="sc-metric-label">Total de Vendas</div>
                <div class="sc-metric-value">@relatorio.Sum(r => r.TotalVendas)</div>
                <div class="sc-metric-sub">Transações realizadas</div>
            </div>
        </div>
    </div>

    <!-- Performance table -->
    <div class="mb-2">
        <h5>Desempenho por Filial</h5>
    </div>
    <div class="sc-table-card mb-4">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Filial</th>
                        <th>Estado</th>
                        <th class="text-end">Faturado</th>
                        <th class="text-end">Despesas</th>
                        <th class="text-end">Margem Bruta</th>
                        <th class="text-end">Vendas</th>
                        <th class="text-center">Alertas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in relatorio)
                    {
                        <tr>
                            <td style="font-weight:500">@r.NomeFilial</td>
                            <td><span class="sc-estado-badge">@r.Estado</span></td>
                            <td class="text-end" style="font-variant-numeric:tabular-nums">@r.TotalFaturado.ToString("C")</td>
                            <td class="text-end text-danger" style="font-variant-numeric:tabular-nums">@r.TotalDespesas.ToString("C")</td>
                            <td class="text-end fw-bold" style="color:@(r.MargemBruta >= 0 ? "#2e7d32" : "#ff3b30");font-variant-numeric:tabular-nums">
                                @r.MargemBruta.ToString("C")
                            </td>
                            <td class="text-end" style="color:#6e6e73">@r.TotalVendas</td>
                            <td class="text-center">
                                @if (r.ProdutosComAlerta > 0)
                                {
                                    <span class="badge bg-warning">@r.ProdutosComAlerta</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">OK</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:#fafafa;font-weight:600;font-size:0.78rem;color:#6e6e73;border-top:2px solid rgba(0,0,0,0.08)">
                        <td colspan="2" style="padding-left:1rem">TOTAL DA REDE</td>
                        <td class="text-end" style="font-variant-numeric:tabular-nums">@relatorio.Sum(r => r.TotalFaturado).ToString("C")</td>
                        <td class="text-end text-danger" style="font-variant-numeric:tabular-nums">@relatorio.Sum(r => r.TotalDespesas).ToString("C")</td>
                        <td class="text-end fw-bold" style="color:@(relatorio.Sum(r => r.MargemBruta) >= 0 ? "#2e7d32" : "#ff3b30");font-variant-numeric:tabular-nums">
                            @relatorio.Sum(r => r.MargemBruta).ToString("C")
                        </td>
                        <td class="text-end">@relatorio.Sum(r => r.TotalVendas)</td>
                        <td class="text-center">@relatorio.Sum(r => r.ProdutosComAlerta)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="sc-table-foot">@relatorio.Count filiais</div>
    </div>
}

@if (topProdutos.Any())
{
    <div class="mb-2">
        <h5>Produtos Mais Vendidos — Top 10</h5>
    </div>
    <div class="sc-table-card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th class="text-end" style="width:3rem">#</th>
                        <th>Produto</th>
                        <th class="text-end">Qtd. Vendida</th>
                        <th class="text-end">Faturamento</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int pos = 0; }
                    @foreach (var p in topProdutos)
                    {
                        pos++;
                        <tr>
                            <td class="text-end" style="color:#aaaaaa;font-size:0.7rem">@pos</td>
                            <td style="font-weight:500">@p.NomeProduto</td>
                            <td class="text-end" style="color:#6e6e73;font-variant-numeric:tabular-nums">@p.QuantidadeVendida</td>
                            <td class="text-end fw-bold text-success" style="font-variant-numeric:tabular-nums">@p.ValorTotalVendido.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="sc-table-foot">@topProdutos.Count produtos</div>
    </div>
}

@if (!relatorio.Any() && !carregando)
{
    <div class="sc-table-card p-5 text-center" style="border-radius:0.75rem">
        <div style="color:#aaaaaa;font-size:0.85rem">
            Selecione o período e clique em <strong>Gerar Relatório</strong> para visualizar os dados.
        </div>
    </div>
}

@code {
    private List<RelatorioFilialDto> relatorio = new();
    private List<ProdutoMaisVendidoDto> topProdutos = new();
    private List<Filial> filiais = new();
    private int filialId = 0;
    private DateTime inicio = DateTime.Today.AddDays(-30);
    private DateTime fim = DateTime.Today;
    private bool carregando = false;

    protected override async Task OnInitializedAsync()
        => filiais = (await FilialSvc.ListarAsync()).ToList();

    private async Task GerarAsync()
    {
        carregando = true;
        try
        {
            if (filialId == 0)
                relatorio = (await RelatorioSvc.GerarRelatorioRedeAsync(inicio, fim.AddDays(1))).ToList();
            else
                relatorio = new List<RelatorioFilialDto> { await RelatorioSvc.GerarRelatorioFilialAsync(filialId, inicio, fim.AddDays(1)) };

            topProdutos = (await RelatorioSvc.GerarProdutosMaisVendidosAsync(inicio, fim.AddDays(1))).ToList();
        }
        finally
        {
            carregando = false;
        }
    }
}
