@page "/relatorios"
@rendermode InteractiveServer
@inject RelatorioService RelatorioSvc
@inject FilialService FilialSvc

<PageTitle>Relatórios — SisControle</PageTitle>

<div class="container-fluid py-3">
    <h2 class="mb-4">Relatórios Gerenciais</h2>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label">De</label>
            <input type="date" class="form-control" @bind="inicio" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Até</label>
            <input type="date" class="form-control" @bind="fim" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Filial (vazio = todas)</label>
            <select class="form-select" @bind="filialId">
                <option value="0">Toda a rede</option>
                @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100" @onclick="GerarAsync">Gerar Relatório</button>
        </div>
    </div>

    @if (carregando)
    {
        <div class="d-flex align-items-center gap-2 mt-3">
            <div class="spinner-border spinner-border-sm text-primary"></div>
            <span>Gerando relatório...</span>
        </div>
    }

    @if (relatorio.Any())
    {
        <h5 class="mt-4">Desempenho por Filial — @inicio.ToString("dd/MM/yyyy") a @fim.ToString("dd/MM/yyyy")</h5>
        <div class="table-responsive mb-4">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Filial</th><th>Estado</th><th>Faturado</th><th>Despesas</th>
                        <th>Margem Bruta</th><th>Vendas</th><th>Alertas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in relatorio)
                    {
                        <tr>
                            <td>@r.NomeFilial</td>
                            <td>@r.Estado</td>
                            <td>@r.TotalFaturado.ToString("C")</td>
                            <td class="text-danger">@r.TotalDespesas.ToString("C")</td>
                            <td class="@(r.MargemBruta >= 0 ? "text-success" : "text-danger") fw-bold">@r.MargemBruta.ToString("C")</td>
                            <td>@r.TotalVendas</td>
                            <td>
                                @if (r.ProdutosComAlerta > 0)
                                { <span class="badge bg-warning text-dark">@r.ProdutosComAlerta</span> }
                                else
                                { <span class="badge bg-success">0</span> }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary fw-bold">
                    <tr>
                        <td>TOTAL DA REDE</td>
                        <td></td>
                        <td>@relatorio.Sum(r => r.TotalFaturado).ToString("C")</td>
                        <td class="text-danger">@relatorio.Sum(r => r.TotalDespesas).ToString("C")</td>
                        <td class="@(relatorio.Sum(r => r.MargemBruta) >= 0 ? "text-success" : "text-danger")">
                            @relatorio.Sum(r => r.MargemBruta).ToString("C")
                        </td>
                        <td>@relatorio.Sum(r => r.TotalVendas)</td>
                        <td>@relatorio.Sum(r => r.ProdutosComAlerta)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    @if (topProdutos.Any())
    {
        <h5>Produtos Mais Vendidos (Top 10)</h5>
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead class="table-info">
                    <tr><th>Posição</th><th>Produto</th><th>Qtd. Vendida</th><th>Faturamento</th></tr>
                </thead>
                <tbody>
                    @{int pos = 1;}
                    @foreach (var p in topProdutos)
                    {
                        <tr>
                            <td>@pos++</td>
                            <td>@p.NomeProduto</td>
                            <td>@p.QuantidadeVendida</td>
                            <td>@p.ValorTotalVendido.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<RelatorioFilialDto> relatorio = new();
    private List<ProdutoMaisVendidoDto> topProdutos = new();
    private List<Filial> filiais = new();
    private int filialId = 0;
    private DateTime inicio = DateTime.Today.AddDays(-30);
    private DateTime fim = DateTime.Today;
    private bool carregando = false;

    protected override async Task OnInitializedAsync()
        => filiais = (await FilialSvc.ListarAsync()).ToList();

    private async Task GerarAsync()
    {
        carregando = true;
        try
        {
            if (filialId == 0)
                relatorio = (await RelatorioSvc.GerarRelatorioRedeAsync(inicio, fim.AddDays(1))).ToList();
            else
                relatorio = new List<RelatorioFilialDto> { await RelatorioSvc.GerarRelatorioFilialAsync(filialId, inicio, fim.AddDays(1)) };

            topProdutos = (await RelatorioSvc.GerarProdutosMaisVendidosAsync(inicio, fim.AddDays(1))).ToList();
        }
        finally
        {
            carregando = false;
        }
    }
}
