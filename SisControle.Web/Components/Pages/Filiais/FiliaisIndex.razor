@page "/filiais"
@rendermode InteractiveServer
@inject FilialService FilialSvc

<PageTitle>Filiais — SisControle</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Filiais</h2>
        <button class="btn btn-primary" @onclick="() => AbrirModal(null)">+ Nova Filial</button>
    </div>

    @if (mensagem != null)
    {
        <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible">
            @mensagem
            <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th><th>Nome</th><th>CNPJ</th><th>Cidade</th><th>Estado</th><th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in filiais)
                {
                    <tr>
                        <td>@f.Id</td>
                        <td>@f.Nome</td>
                        <td>@f.Cnpj</td>
                        <td>@f.Cidade</td>
                        <td>@f.Estado</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => AbrirModal(f)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ExcluirAsync(f.Id)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (modalAberto)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modelo.Id == 0 ? "Nova Filial" : "Editar Filial")</h5>
                    <button type="button" class="btn-close" @onclick="() => modalAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Nome *</label>
                        <input class="form-control" @bind="modelo.Nome" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">CNPJ *</label>
                        <input class="form-control" @bind="modelo.Cnpj" placeholder="00.000.000/0001-00" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Endereço</label>
                        <input class="form-control" @bind="modelo.Endereco" />
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-2">
                            <label class="form-label">Cidade *</label>
                            <input class="form-control" @bind="modelo.Cidade" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label">Estado *</label>
                            <input class="form-control" @bind="modelo.Estado" maxlength="2" placeholder="SP" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Telefone</label>
                        <input class="form-control" @bind="modelo.Telefone" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => modalAberto = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarAsync">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Filial> filiais = new();
    private Filial modelo = new();
    private bool modalAberto = false;
    private string? mensagem;
    private bool erro = false;

    protected override async Task OnInitializedAsync()
        => filiais = (await FilialSvc.ListarAsync()).ToList();

    private void AbrirModal(Filial? filial)
    {
        modelo = filial == null ? new Filial() : new Filial
        {
            Id = filial.Id, Nome = filial.Nome, Cnpj = filial.Cnpj,
            Endereco = filial.Endereco, Cidade = filial.Cidade,
            Estado = filial.Estado, Telefone = filial.Telefone
        };
        modalAberto = true;
    }

    private async Task SalvarAsync()
    {
        try
        {
            if (modelo.Id == 0) await FilialSvc.CadastrarAsync(modelo);
            else await FilialSvc.AtualizarAsync(modelo);
            filiais = (await FilialSvc.ListarAsync()).ToList();
            modalAberto = false;
            mensagem = "Filial salva com sucesso!";
            erro = false;
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }

    private async Task ExcluirAsync(int id)
    {
        try
        {
            await FilialSvc.ExcluirAsync(id);
            filiais = (await FilialSvc.ListarAsync()).ToList();
            mensagem = "Filial removida.";
            erro = false;
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            erro = true;
        }
    }
}
