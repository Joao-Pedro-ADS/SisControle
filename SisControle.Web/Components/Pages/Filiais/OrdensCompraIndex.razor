@page "/ordens-compra"
@rendermode InteractiveServer
@inject OrdemCompraService OrdemCompraSvc
@inject FilialService FilialSvc
@inject FornecedorService FornecedorSvc
@inject ProdutoService ProdutoSvc

<PageTitle>Ordens de Compra — SisControle</PageTitle>

<SectionContent SectionName="page-title">Ordens de Compra</SectionContent>

@if (mensagem != null)
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<!-- Filter -->
<div class="sc-table-card mb-3 p-3" style="border-radius:0.75rem">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Filial</label>
            <select class="form-select" @bind="filialId" @bind:after="CarregarAsync">
                <option value="0">Selecione...</option>
                @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
            </select>
        </div>
    </div>
</div>

<div class="sc-table-card">
    <div class="sc-toolbar">
        <span class="sc-count">@ordens.Count ordens</span>
        <button class="btn btn-primary btn-sm" @onclick="() => modalAberto = true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nova Ordem
        </button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:2.5rem">#</th>
                    <th>Data</th>
                    <th>Fornecedor</th>
                    <th>Status</th>
                    <th class="text-end">Valor Total</th>
                    <th>Recebimento</th>
                    <th class="text-center" style="width:9rem">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!ordens.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5" style="color:#aaaaaa;font-size:0.8rem">
                            @(filialId == 0 ? "Selecione uma filial para ver as ordens" : "Nenhuma ordem de compra encontrada")
                        </td>
                    </tr>
                }
                @{ int i = 0; }
                @foreach (var o in ordens)
                {
                    i++;
                    <tr>
                        <td class="text-end" style="color:#aaaaaa;font-size:0.7rem">@i</td>
                        <td style="font-size:0.72rem;color:#6e6e73">@o.DataPedido.ToString("dd/MM/yyyy")</td>
                        <td style="font-weight:500">@o.Fornecedor?.Nome</td>
                        <td>
                            @{
                                var (sbg, sfg) = o.Status switch
                                {
                                    StatusOrdemCompra.Pendente  => ("#fff8e1", "#e65100"),
                                    StatusOrdemCompra.Aprovada  => ("#e8f0fd", "#0071e3"),
                                    StatusOrdemCompra.Recebida  => ("#e8f5e9", "#2e7d32"),
                                    StatusOrdemCompra.Cancelada => ("#fff0ef", "#ff3b30"),
                                    _ => ("#f5f5f7", "#6e6e73")
                                };
                            }
                            <span class="badge" style="background:@sbg;color:@sfg">@o.Status</span>
                        </td>
                        <td class="text-end fw-bold" style="font-variant-numeric:tabular-nums">@o.ValorTotal.ToString("C")</td>
                        <td style="color:#6e6e73;font-size:0.72rem">@(o.DataRecebimento?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                @if (o.Status == StatusOrdemCompra.Pendente || o.Status == StatusOrdemCompra.Aprovada)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => ReceberAsync(o.Id)">Receber</button>
                                }
                                @if (o.Status == StatusOrdemCompra.Pendente)
                                {
                                    <button class="sc-btn-icon delete" title="Cancelar" @onclick="() => CancelarAsync(o.Id)">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="sc-table-foot">@ordens.Count ordens</div>
</div>

@if (modalAberto)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.35)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nova Ordem de Compra</h5>
                    <button class="sc-btn-close" @onclick="FecharModal">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Filial *</label>
                            <select class="form-select" @bind="novaOrdem.FilialId">
                                <option value="0">Selecione...</option>
                                @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fornecedor *</label>
                            <select class="form-select" @bind="novaOrdem.FornecedorId">
                                <option value="0">Selecione...</option>
                                @foreach (var f in fornecedores) { <option value="@f.Id">@f.Nome</option> }
                            </select>
                        </div>
                    </div>

                    <h6 class="mb-2">Adicionar Itens</h6>
                    <div class="row g-2 mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Produto *</label>
                            <select class="form-select" @bind="addProdutoId">
                                <option value="0">Selecione...</option>
                                @foreach (var p in produtos) { <option value="@p.Id">@p.Nome</option> }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Quantidade *</label>
                            <input type="number" min="1" class="form-control" @bind="addQtd" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Preço Unit. *</label>
                            <input type="number" step="0.01" class="form-control" @bind="addPreco" placeholder="0,00" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary w-100" @onclick="AdicionarItemOrdem">Adicionar</button>
                        </div>
                    </div>

                    @if (itensOrdem.Any())
                    {
                        <div class="sc-table-card" style="border-radius:0.5rem">
                            <table class="table table-sm mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Produto</th>
                                        <th class="text-end">Qtd</th>
                                        <th class="text-end">Preço Unit.</th>
                                        <th class="text-end">Subtotal</th>
                                        <th style="width:2rem"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in itensOrdem)
                                    {
                                        <tr>
                                            <td>@item.NomeProduto</td>
                                            <td class="text-end">@item.Quantidade</td>
                                            <td class="text-end" style="color:#6e6e73">@item.PrecoUnitario.ToString("C")</td>
                                            <td class="text-end fw-bold">@((item.Quantidade * item.PrecoUnitario).ToString("C"))</td>
                                            <td>
                                                <button class="sc-btn-icon delete" @onclick="() => itensOrdem.Remove(item)">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end" style="font-size:0.75rem;color:#6e6e73;border-top:1px solid rgba(0,0,0,0.08)">Total:</td>
                                        <td class="text-end fw-bold" style="border-top:1px solid rgba(0,0,0,0.08)">
                                            @itensOrdem.Sum(i => i.Quantidade * i.PrecoUnitario).ToString("C")
                                        </td>
                                        <td style="border-top:1px solid rgba(0,0,0,0.08)"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarOrdemAsync">Criar Ordem</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    record ItemOrdemForm(int ProdutoId, string NomeProduto, int Quantidade, decimal PrecoUnitario);

    private List<OrdemCompra> ordens = new();
    private List<Filial> filiais = new();
    private List<Fornecedor> fornecedores = new();
    private List<Produto> produtos = new();
    private List<ItemOrdemForm> itensOrdem = new();
    private OrdemCompra novaOrdem = new();
    private int filialId = 0;
    private int addProdutoId = 0, addQtd = 1;
    private decimal addPreco = 0;
    private bool modalAberto = false;
    private string? mensagem;
    private bool erro = false;

    protected override async Task OnInitializedAsync()
    {
        filiais      = (await FilialSvc.ListarAsync()).ToList();
        fornecedores = (await FornecedorSvc.ListarAsync()).ToList();
        produtos     = (await ProdutoSvc.ListarAsync()).ToList();
    }

    private async Task CarregarAsync()
    {
        if (filialId > 0)
            ordens = (await OrdemCompraSvc.ListarPorFilialAsync(filialId)).ToList();
    }

    private void FecharModal()
    {
        modalAberto = false;
        novaOrdem   = new OrdemCompra();
        itensOrdem.Clear();
        addProdutoId = 0; addQtd = 1; addPreco = 0;
    }

    private void AdicionarItemOrdem()
    {
        if (addProdutoId == 0 || addQtd <= 0 || addPreco <= 0) return;
        var produto = produtos.FirstOrDefault(p => p.Id == addProdutoId);
        if (produto == null) return;
        var existente = itensOrdem.FirstOrDefault(i => i.ProdutoId == addProdutoId);
        if (existente != null) itensOrdem.Remove(existente);
        itensOrdem.Add(new ItemOrdemForm(produto.Id, produto.Nome, addQtd, addPreco));
        addProdutoId = 0; addQtd = 1; addPreco = 0;
    }

    private async Task SalvarOrdemAsync()
    {
        try
        {
            novaOrdem.Itens = itensOrdem.Select(i => new ItemOrdemCompra
            {
                ProdutoId      = i.ProdutoId,
                Quantidade     = i.Quantidade,
                PrecoUnitario  = i.PrecoUnitario
            }).ToList();

            await OrdemCompraSvc.CriarAsync(novaOrdem);
            await CarregarAsync();
            FecharModal();
            mensagem = "Ordem de compra criada!";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }

    private async Task ReceberAsync(int ordemId)
    {
        try
        {
            await OrdemCompraSvc.ReceberAsync(ordemId);
            await CarregarAsync();
            mensagem = "Recebimento registrado e estoque atualizado!";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }

    private async Task CancelarAsync(int ordemId)
    {
        try
        {
            await OrdemCompraSvc.AtualizarStatusAsync(ordemId, StatusOrdemCompra.Cancelada);
            await CarregarAsync();
            mensagem = "Ordem cancelada.";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }
}
