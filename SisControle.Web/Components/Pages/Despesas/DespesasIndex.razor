@page "/despesas"
@rendermode InteractiveServer
@inject DespesaService DespesaSvc
@inject FilialService FilialSvc

<PageTitle>Despesas Operacionais — SisControle</PageTitle>

<SectionContent SectionName="page-title">Despesas Operacionais</SectionContent>

@if (mensagem != null)
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible mb-3">
        @mensagem
        <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
    </div>
}

<div class="sc-table-card mb-3 p-3" style="border-radius:0.75rem">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Filial</label>
            <select class="form-select" @bind="filialId" @bind:after="CarregarAsync">
                <option value="0">Selecione...</option>
                @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
            </select>
        </div>
        @if (filialId > 0 && despesas.Any())
        {
            <div class="col-md-4 d-flex align-items-end">
                <div>
                    <div style="font-size:0.7rem;color:#aaaaaa;margin-bottom:0.2rem">TOTAL DO PERÍODO</div>
                    <div style="font-size:1.1rem;font-weight:600;color:#ff3b30">@despesas.Sum(d => d.Valor).ToString("C")</div>
                </div>
            </div>
        }
    </div>
</div>

@if (filialId > 0)
{
    <div class="sc-table-card">
        <div class="sc-toolbar">
            <span class="sc-count">@despesas.Count despesas</span>
            <button class="btn btn-primary btn-sm" @onclick="() => AbrirModal()">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nova Despesa
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Tipo</th>
                        <th>Descrição</th>
                        <th class="text-end">Valor</th>
                        <th>Competência</th>
                        <th>Data Lançamento</th>
                        <th class="text-center" style="width:5rem">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!despesas.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5" style="color:#aaaaaa;font-size:0.8rem">
                                Nenhuma despesa registrada para esta filial
                            </td>
                        </tr>
                    }
                    @foreach (var d in despesas)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@d.Tipo</span></td>
                            <td style="font-weight:500">@d.Descricao</td>
                            <td class="text-end text-danger fw-bold" style="font-variant-numeric:tabular-nums">@d.Valor.ToString("C")</td>
                            <td style="color:#6e6e73;font-size:0.72rem">@d.Competencia</td>
                            <td style="color:#6e6e73;font-size:0.72rem">@d.DataLancamento.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <button class="sc-btn-icon delete" title="Excluir" @onclick="() => ExcluirAsync(d.Id)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="sc-table-foot">@despesas.Count despesas</div>
    </div>
}

@if (modalAberto)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.35)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nova Despesa</h5>
                    <button class="sc-btn-close" @onclick="() => modalAberto = false">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Filial *</label>
                        <select class="form-select" @bind="modelo.FilialId">
                            <option value="0">Selecione...</option>
                            @foreach (var f in filiais) { <option value="@f.Id">@f.Nome</option> }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo *</label>
                        <select class="form-select" @bind="modelo.Tipo">
                            @foreach (var t in Enum.GetValues<TipoDespesa>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descrição *</label>
                        <input class="form-control" @bind="modelo.Descricao" placeholder="Ex: Conta de energia" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Valor *</label>
                            <input type="number" step="0.01" class="form-control" @bind="modelo.Valor" placeholder="0,00" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Competência</label>
                            <input class="form-control" @bind="modelo.Competencia" placeholder="MM/AAAA" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => modalAberto = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarAsync">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DespesaOperacional> despesas = new();
    private List<Filial> filiais = new();
    private DespesaOperacional modelo = new();
    private int filialId = 0;
    private bool modalAberto = false;
    private string? mensagem;
    private bool erro = false;

    protected override async Task OnInitializedAsync()
        => filiais = (await FilialSvc.ListarAsync()).ToList();

    private async Task CarregarAsync()
    {
        if (filialId > 0)
            despesas = (await DespesaSvc.ListarPorFilialAsync(filialId)).ToList();
    }

    private void AbrirModal()
    {
        modelo = new DespesaOperacional { FilialId = filialId };
        modalAberto = true;
    }

    private async Task SalvarAsync()
    {
        try
        {
            await DespesaSvc.RegistrarAsync(modelo);
            await CarregarAsync();
            modalAberto = false;
            mensagem = "Despesa registrada!";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }

    private async Task ExcluirAsync(int id)
    {
        try
        {
            await DespesaSvc.ExcluirAsync(id);
            await CarregarAsync();
            mensagem = "Despesa removida.";
            erro = false;
        }
        catch (Exception ex) { mensagem = ex.Message; erro = true; }
    }
}
