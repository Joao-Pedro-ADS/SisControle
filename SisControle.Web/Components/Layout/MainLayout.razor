@inherits LayoutComponentBase

<MudThemeProvider Theme="_mudTheme" />
<MudPopoverProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <span class="sc-page-title"><SectionOutlet SectionName="page-title" /></span>
            <span class="text-muted" style="font-size:0.75rem">@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private MudTheme _mudTheme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary        = "#0071e3",
            PrimaryDarken  = "#0077ed",
            Secondary      = "#ff3b30",
            Tertiary       = "#2e7d32",
            Background     = "#f5f5f7",
            Surface        = "#ffffff",
            DrawerBackground = "#ffffff",
            AppbarBackground = "#ffffff",
            TextPrimary    = "#1d1d1f",
            TextSecondary  = "#6e6e73",
        }
    };
}

<div id="blazor-error-ui" data-nosnippet>
    Um erro inesperado ocorreu.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">✕</span>
</div>
